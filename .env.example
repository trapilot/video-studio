# Which video type new productions produce (id from src/entities/profile.rs). Default: kids_edu
STUDIO_PROFILE=
# Folder holding characters/<profile_id>/*.toml. Default: ./data
STUDIO_DATA_DIR=

# Gemini model for every key (default: gemini-3.8-flash)
GEMINI_MODEL=
GEMINI_KEY_1=
GEMINI_KEY_2=

ELEVEN_LABS_KEY_1=
ELEVEN_LABS_KEY_2=

CF_WORKER_KEY_1=
CF_WORKER_ACCOUNT_1=
CF_WORKER_KEY_2=
CF_WORKER_ACCOUNT_2=



YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: skip the browser login by providing a refresh token directly
YOUTUBE_REFRESH_TOKEN=

TIKTOK_ACCESS_TOKEN=

